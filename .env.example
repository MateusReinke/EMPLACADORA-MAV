# Copie para .env e ajuste antes de subir.
# Em produção (NODE_ENV=production) o servidor recusa iniciar sem os segredos.

NODE_ENV=production
APP_PORT=8090

# ---------------------------------------------------------------------------
# Banco de dados — escolha UM dos dois modos
# ---------------------------------------------------------------------------

# MODO EMBUTIDO (padrão): o PostgreSQL sobe dentro do próprio container.
# Bom para demonstração e desenvolvimento. Deixe DATABASE_URL vazio.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5435
POSTGRES_DB=emplacadora
POSTGRES_USER=emplacadora
POSTGRES_PASSWORD=troque-esta-senha

# MODO EXTERNO: aponte para um PostgreSQL gerenciado (com backup e escala).
# Basta definir DATABASE_URL — o PostgreSQL embutido não é sequer iniciado, e
# POSTGRES_PASSWORD deixa de ser necessária (a senha vai dentro da URL).
# DATABASE_URL=postgres://usuario:senha@host:5432/emplacadora

# TLS da conexão: require (padrão no modo externo), verify-full ou disable.
# A maioria dos provedores gerenciados exige TLS com certificado próprio, o que
# corresponde a require.
# POSTGRES_SSL=require
# POSTGRES_SSL_CA=

# ---------------------------------------------------------------------------
# Segredos — gere valores próprios, por exemplo com `openssl rand -hex 24`
# ---------------------------------------------------------------------------

DEFAULT_ADMIN_EMAIL=admin@emplacadora.com
DEFAULT_ADMIN_NAME=Administrador Padrão
DEFAULT_ADMIN_PASSWORD=troque-esta-senha
INTEGRATION_API_KEY=troque-esta-chave

# ---------------------------------------------------------------------------
# Dados iniciais
# ---------------------------------------------------------------------------
# Um banco novo nasce apenas com o essencial (status de pedido, tipos de placa e
# de veículo, categorias de serviço). Tipos de serviço, preços e estoque são
# cadastrados pelo cliente nas telas de administração.
# Defina como true para carregar dados de exemplo (deploy/seed_emplacadora.sql).
SEED_DEMO_DATA=false
