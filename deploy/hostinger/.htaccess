# =============================================================================
# MAV Emplacamento — site público em hospedagem compartilhada (Hostinger)
#
# Copiado para dentro de dist/ por `npm run build:hostinger`. O conteúdo de
# dist/ vai inteiro para public_html.
# =============================================================================

Options -Indexes

RewriteEngine On

# ---------------------------------------------------------------------------
# Domínio canônico: mavemplacamento.com.br, sem www.
#
# Vem antes da regra de HTTPS e já aponta para https://, então
# http://www.… resolve em um salto só. Sem isso, o Google trataria
# www e sem-www como dois sites com o mesmo conteúdo e dividiria a
# autoridade entre eles. É o mesmo domínio declarado em SITE_URL
# (src/content/site.ts), que assina canonical, OG tags e sitemap.
# ---------------------------------------------------------------------------
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# ---------------------------------------------------------------------------
# HTTPS obrigatório. O site pede WhatsApp e endereço; servir em HTTP custa
# confiança e posição no Google.
# ---------------------------------------------------------------------------
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ---------------------------------------------------------------------------
# O site chama /api/google-reviews (mesma rota do server.js em Node). Aqui quem
# atende é o arquivo PHP — este rewrite mantém uma única URL nos dois deploys,
# em vez de precisar de um build diferente por hospedagem.
# ---------------------------------------------------------------------------
RewriteRule ^api/google-reviews/?$ /api/google-reviews.php [L]

# ---------------------------------------------------------------------------
# Arquivos e diretórios que existem de verdade são servidos direto.
# ---------------------------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# ---------------------------------------------------------------------------
# Fallback da SPA em duas variantes (ver scripts/prerender.mjs):
#   - rotas do painel  → app-shell.html, o shell vazio;
#   - qualquer outra   → index.html, a home já pré-renderizada.
#
# Servir a home pré-renderizada numa rota do painel faria o navegador pintar e
# jogar fora um conteúdo que não é daquela tela.
# ---------------------------------------------------------------------------
RewriteRule ^(login|admin|seller|client|dashboard|orders|kanban|clients|sellers|settings|profile|index)(/.*)?$ /app-shell.html [L]
RewriteRule ^ /index.html [L]

# ---------------------------------------------------------------------------
# Cache
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
  # Bundles com hash no nome nunca mudam de conteúdo.
  <FilesMatch "-[A-Za-z0-9_-]{8,}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML sempre revalidado: é o que carrega os bundles novos após um deploy.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Imagens, ícones e fontes: sem hash no nome, então 30 dias.
  <FilesMatch "\.(svg|jpg|jpeg|png|webp|avif|ico|woff2?)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ---------------------------------------------------------------------------
# Compressão
# ---------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml \
    application/javascript application/json application/xml image/svg+xml
</IfModule>

# ---------------------------------------------------------------------------
# A chave da Places API mora em api/config.php. O PHP continua conseguindo
# incluir o arquivo; o que fica bloqueado é o acesso pela web.
# ---------------------------------------------------------------------------
<Files "config.php">
  Require all denied
</Files>
<Files "config.example.php">
  Require all denied
</Files>

# ---------------------------------------------------------------------------
# Restos do WordPress que ficaram para trás em public_html.
#
# `wp-config.php_old` e `wp-config.php.bak.*` guardam usuário e senha do banco
# em texto puro. Com essas extensões o servidor não os executa como PHP — ele
# entrega o conteúdo como texto para quem pedir a URL, e esses nomes estão na
# lista que os scanners automáticos testam sozinhos.
#
# O certo é apagar os arquivos (o firewall da hospedagem bloqueia a exclusão
# pelo gerenciador web; dá para fazer por FTP ou SSH). Enquanto isso não
# acontece, esta regra fecha o acesso pela web. É remendo, não solução.
# ---------------------------------------------------------------------------
<FilesMatch "^wp-config">
  Require all denied
</FilesMatch>

ErrorDocument 404 /index.html
